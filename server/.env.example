# Copy this file to .env and fill in your real values.
# NEVER commit .env, never paste its contents into a chat, email, or ticket.

# --- From your KCB Buni onboarding email ---
KCB_CONSUMER_KEY=
KCB_CONSUMER_SECRET=
KCB_ORG_SHORTCODE=
# Usually left blank unless KCB tells you otherwise
KCB_ORG_PASSKEY=

# --- Environment ---
# Sandbox first. Switch to https://api.buni.kcbgroup.com once you're approved for production
# (after emailing the signed go-live letter to buni@kcbgroup.com).
KCB_BASE_URL=https://uat.buni.kcbgroup.com

# --- Your server ---
# Must be a public HTTPS URL KCB can reach — use ngrok/Tunnelmole while testing locally,
# your real domain once deployed.
CALLBACK_BASE_URL=https://your-domain-or-tunnel.example.com
PORT=4000

# Comma-separated list of origins allowed to call this API (your storefront's URL)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Admin panel ---
# A real password, not the demo one from earlier. Change this before publishing.
ADMIN_PASSWORD=
